<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ListPreference
        app:key="pinyin_spelling"
        app:title="@string/settings_input_mode_pinyin_spelling_title"
        app:entries="@array/settings_input_mode_pinyin_spelling_entries"
        app:entryValues="@array/settings_input_mode_pinyin_spelling_values"
        app:defaultValue="FullPinyin"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreferenceCompat
        app:key="chinese_traditional"
        app:title="@string/settings_input_mode_chinese_traditional_title" />

</androidx.preference.PreferenceScreen>
